# ── Terraform ────────────────────────────────────────────────────────
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup
infra/terraform/.terraform.lock.hcl

# ── Logs & Samples ───────────────────────────────────────────────────
sample/*.log
*.log

# ── Docker ───────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Misc ─────────────────────────────────────────────────────────────
TREMOR_ANTIGRAVITY_PROMPT.md
infra/terraform/terraform.exe
infra/terraform/LICENSE.txt
# ── Secrets & credentials (never commit; use env vars / a secret manager) ──
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.tfvars
!*.tfvars.example
**/.terraform/
*.tfstate*
credentials.json
service-account*.json

# ── Go build / test artifacts ────────────────────────────────────────
*.test
*.prof
coverage.out

# ── Backups & dumps ──────────────────────────────────────────────────
*.bak
*.dump
