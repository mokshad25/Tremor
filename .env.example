# ── TREMOR Configuration ──────────────────────────────────────────────
# Copy to .env and customize. All values have sane defaults.

# ── Ingestion ─────────────────────────────────────────────────────────
LOG_PATHS=./sample/app.log
TAIL_START=end                    # end | beginning (beginning for replay/eval)
POLL_INTERVAL_MS=150
LATENESS_S=5

# ── Windows & Baseline ───────────────────────────────────────────────
WINDOWS_S=10,60,300
WARMUP_SECONDS=300                # Not used by detection; see WARMUP_TICKS
MIN_EVENTS=20                     # Min lines (or latency samples) per 30 s window

# ── Detection Baseline (EWMA) ────────────────────────────────────────
DETECTION_WINDOW_S=30             # Arrival-time window for error rate and latency p95
WARMUP_TICKS=30                   # Ticks with MIN_EVENTS lines that seed the baseline
ALPHA=0.01                        # EWMA smoothing factor
SIGMA_MIN=0.01                    # Floor on sigma_eff for error rate
BASELINE_UPDATE_MAX_Z=2.0         # Baseline only learns from ticks below this z

# ── Severity Z-score Thresholds ──────────────────────────────────────
Z_INFO=3
Z_WARN=5
Z_HIGH=8
Z_CRIT=6                          # Not used: CRITICAL is the RATE_CEILING rule
RATE_CEILING=0.5                  # Hard critical ceiling (50%)
CLEAR_Z=2.0                       # Hysteresis: a tick is clear below this z
CLEAR_WINDOWS=10                  # Consecutive clear 1 s ticks to resolve

# ── Silence Detection ────────────────────────────────────────────────
SILENCE_SECONDS=10

# ── Latency / New Pattern ────────────────────────────────────────────
LATENCY_PERCENTILE=0.95
LATENCY_FLOOR_FRAC=0.1            # sigma_eff >= this fraction of baseline p95
LATENCY_SIGMA_MIN_MS=1.0
NEW_PATTERN_MIN_COUNT=5           # New-template lines in the 30 s window needed to alert
NEW_PATTERN_RESOLVE_S=60          # Resolve after this long without the template

# ── Alert Manager ────────────────────────────────────────────────────
ALERT_COOLDOWN_S=60

# ── AWS ──────────────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=               # Use IAM roles in production
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
SNS_TOPIC_ARN=
CW_LOG_GROUP=/tremor/alerts
CW_LOG_STREAM=default
CW_NAMESPACE=Tremor
# Set to http://localhost:4566 for LocalStack. Keep comments off empty
# values: docker compose would read the comment as the value.
AWS_ENDPOINT_URL=

# ── Modes ────────────────────────────────────────────────────────────
DRY_RUN=true                      # Set false (with AWS credentials) to send real alerts
DEMO_MODE=false

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./tremor.db

# ── Server ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*                    # Comma-separated origins; * for dev only

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
