   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Rejected requests per second",
   "description": "429 = queue full (producers retry with backoff); 503 = draining or WAL failure; bad_request = invalid input.",
