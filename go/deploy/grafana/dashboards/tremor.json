  {
   "type": "timeseries",
   "title": "Events per second",
   "description": "Accepted = acknowledged to producers after fsync. Processed = consumed by the shards.",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(tremor_events_accepted_total[1m]))",
     "legendFormat": "accepted (fsynced, acked)",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(tremor_events_processed_total[1m]))",
     "legendFormat": "processed by shards",
     "refId": "B"
