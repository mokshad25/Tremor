   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (result) (rate(tremor_ingest_requests_total{result!=\"accepted\"}[1m]))",
     "legendFormat": "{{result}}",
     "refId": "A"
